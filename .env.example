# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# Значения по умолчанию подходят для локального запуска через docker compose up.

# --- PostgreSQL ---
POSTGRES_DB=music_catalog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Django ---
DJANGO_SECRET_KEY=dev-secret-key-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://postgres:postgres@db:5432/music_catalog

# --- CORS (адреса, с которых frontend обращается к backend) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_PROXY_TARGET=http://backend:8000
