# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# Значения по умолчанию подходят для локального запуска через docker compose up.
#
# ВНИМАНИЕ: этот файл — только шаблон с безопасными значениями по умолчанию.
# Реальные секреты (пароль от продакшн-БД, DJANGO_SECRET_KEY, connection
# string от Neon) сюда никогда не вписываются и не коммитятся — они живут
# только в переменных окружения Render/Vercel (см. раздел «Деплой» в README).

# --- PostgreSQL (только для локального docker compose) ---
POSTGRES_DB=music_catalog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Django ---
DJANGO_SECRET_KEY=dev-secret-key-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://postgres:postgres@db:5432/music_catalog

# --- CORS (адреса, с которых frontend обращается к backend) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (используется в dev, Vite-прокси /api -> backend) ---
VITE_API_PROXY_TARGET=http://backend:8000

# =============================================================================
# Переменные для раздельного деплоя (Render + Vercel + Neon).
# Не используются в docker compose — задаются в дашбордах/CLI хостингов,
# перечислены здесь только для справки, какие вообще нужны и откуда брать.
# =============================================================================

# --- Backend (Render → Environment) ---
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<сгенерировать случайную строку, например: openssl rand -hex 40>
# DJANGO_ALLOWED_HOSTS=<домен, который Render выдаст сервису>.onrender.com
# CORS_ALLOWED_ORIGINS=https://<домен-проекта-на-vercel>.vercel.app
# DATABASE_URL=<connection string из Neon Dashboard → Connection Details, уже с ?sslmode=require>

# --- Frontend (Vercel → Project Settings → Environment Variables) ---
# VITE_API_BASE_URL=https://<домен-backend-на-render>.onrender.com/api
